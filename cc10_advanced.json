{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "UK Bread Prices: Trend Analysis",
    "anchor": "start",
    "subtitle": "Mean price with linear regression | Source: LRPD",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 700,
  "height": 400,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "cc8_bread_prices.json"},
  "transform": [
    {"filter": "datum.price_type == 'Mean'"}
  ],
  "layer": [
    {
      "mark": {"type": "point", "color": "#ff6b42", "opacity": 0.6},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "", "grid": false}},
        "y": {"field": "price", "type": "quantitative", "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "Price (£)", "grid": true}},
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Date"},
          {"field": "price", "type": "quantitative", "title": "Price (£)", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {"type": "line", "color": "#ffffff", "strokeWidth": 2},
      "transform": [
        {"regression": "price", "on": "date"}
      ],
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "price", "type": "quantitative"}
      }
    }
  ]
}