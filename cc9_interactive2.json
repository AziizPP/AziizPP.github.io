{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "UK Bread Prices Over Time",
    "anchor": "start",
    "subtitle": "Adjust slider to filter year range | Source: LRPD",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 700,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "params": [
    {
      "name": "minYear",
      "value": 1988,
      "bind": {
        "input": "range",
        "min": 1988,
        "max": 2024,
        "step": 1,
        "name": "From Year: "
      }
    },
    {
      "name": "maxYear",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1988,
        "max": 2024,
        "step": 1,
        "name": "To Year: "
      }
    }
  ],
  "data": {
    "url": "cc8_bread_prices.json"
  },
  "transform": [
    {"calculate": "year(datum.date)", "as": "year"},
    {"filter": "datum.year >= minYear && datum.year <= maxYear"}
  ],
  "mark": {"type": "line", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "", "grid": false}
    },
    "y": {
      "field": "price",
      "type": "quantitative",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "Price (£)", "grid": true}
    },
    "color": {
      "field": "price_type",
      "type": "nominal",
      "scale": {"range": ["#ff6b42", "#ffffff"]},
      "legend": {"title": "Price Type", "titleColor": "#ececec", "labelColor": "#ececec"}
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "title": "Date"},
      {"field": "price_type", "title": "Type"},
      {"field": "price", "type": "quantitative", "title": "Price (£)", "format": ".2f"}
    ]
  }
}