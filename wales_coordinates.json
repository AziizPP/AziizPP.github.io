  "background": "#2f393f",
  "view": {"stroke": null},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/RADataHub/refs/heads/main/MappingWorkshop/geo_data/LAD_WLS_2025_05.topojson",
        "format": {"type": "topojson", "feature": "object_name"}
      },
      "mark": {"type": "geoshape", "fill": "#ffffff", "stroke": "#1d3327", "strokeWidth": 0.5}
    },
    {
      "data": {
        "values": [
          {"city": "Cardiff", "lat": 51.4816, "lon": -3.1791, "population": 369000},
          {"city": "Swansea", "lat": 51.6214, "lon": -3.9436, "population": 246000},
          {"city": "Newport", "lat": 51.5842, "lon": -2.9977, "population": 159000},
          {"city": "Wrexham", "lat": 53.0429, "lon": -2.9925, "population": 136000},
          {"city": "Barry", "lat": 51.4000, "lon": -3.2833, "population": 56000},
          {"city": "Neath", "lat": 51.6603, "lon": -3.8053, "population": 50000},
          {"city": "Cwmbran", "lat": 51.6538, "lon": -3.0210, "population": 48000},
          {"city": "Llanelli", "lat": 51.6840, "lon": -4.1629, "population": 44000}
        ]
