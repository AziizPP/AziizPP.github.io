{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Year-on-Year FDI Change",
    "anchor": "start",
    "subtitle": "Saudi Arabia (%) | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 700,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "project_fdi_yoy_data.json"},
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"title": "", "labelAngle": -45, "grid": false, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "y": {
      "field": "yoy_change",
      "type": "quantitative",
      "axis": {"title": "Change (%)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}

    },
    "color": {
      "condition": {"test": "datum.yoy_change > 0", "value": "#ff6b42"},
      "value": "#ff6b42"
    },
    "tooltip": [
      {"field": "date", "title": "Year"},
      {"field": "yoy_change", "title": "YoY Change (%)", "format": ".1f"}
    ]
  }
}