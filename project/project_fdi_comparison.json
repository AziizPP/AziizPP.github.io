{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Saudi Arabia vs GCC Peers: FDI Trends",
    "anchor": "start",
    "subtitle": "Comparing major GCC economies | Billion US$ | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 800,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "project_gcc_fdi_all.json"},
  "transform": [
    {"filter": "datum.country == 'Saudi Arabia' || datum.country == 'United Arab Emirates' || datum.country == 'Qatar'"},
    {"calculate": "datum.value / 1e9", "as": "fdi_billions"}
  ],
  "mark": {"type": "line", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"title": "", "labelAngle": -45, "grid": false, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "y": {
      "field": "fdi_billions",
      "type": "quantitative",
      "axis": {"title": "FDI (Billion US$)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {"range": ["#ff8742", "#172229", "#5a9a7a"]},
      "legend": {"title": "Country", "titleColor": "#ececec", "labelColor": "#ececec"}
    },
    "tooltip": [
      {"field": "country", "title": "Country"},
      {"field": "date", "title": "Year"},
      {"field": "fdi_billions", "title": "FDI (Billion US$)", "format": ".1f"}
    ]
  }
}