{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "FDI vs GDP Growth in Saudi Arabia",
    "anchor": "start",
    "subtitle": "With linear regression | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 800,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "project_fdi_gdp_scatter_data.json"},
  "transform": [
    {"calculate": "datum.fdi / 1e9", "as": "fdi_billions"}
  ],
  "layer": [
    {
      "mark": {"type": "circle", "color": "#ff6b42", "size": 80, "opacity": 1},
      "encoding": {
        "x": {
          "field": "fdi_billions",
          "type": "quantitative",
          "axis": {"title": "FDI (Billion US$)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
        },
        "y": {
          "field": "gdp_growth",
          "type": "quantitative",
          "axis": {"title": "GDP Growth (%)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
        },
        "tooltip": [
          {"field": "date", "title": "Year"},
          {"field": "fdi_billions", "title": "FDI (Billion US$)", "format": ".1f"},
          {"field": "gdp_growth", "title": "GDP Growth (%)", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {"type": "line", "color": "#ffffff", "strokeWidth": 2},
      "transform": [
        {"regression": "gdp_growth", "on": "fdi_billions"}
      ],
      "encoding": {
        "x": {"field": "fdi_billions", "type": "quantitative"},
        "y": {"field": "gdp_growth", "type": "quantitative"}
      }
    }
  ]
}