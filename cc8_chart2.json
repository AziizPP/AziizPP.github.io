{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "UK Bread Prices Over Time",
    "anchor": "start",
    "subtitle": "Mean and median prices for white sliced bread (800g) | Source: LRPD",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 700,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "cc8_bread_prices.json"},
  "mark": {"type": "line", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "", "grid": false}
    },
    "y": {
      "field": "price",
      "type": "quantitative",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "Price (£)", "grid": true}
    },
    "color": {
      "field": "price_type",
      "type": "nominal",
      "scale": {"range": ["#ff6b42", "#ffffff"]},
      "legend": {"title": "Price Type", "titleColor": "#ececec", "labelColor": "#ececec"}
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "title": "Date"},
      {"field": "price_type", "title": "Type"},
      {"field": "price", "type": "quantitative", "title": "Price (£)", "format": ".2f"}
    ]
  }
}