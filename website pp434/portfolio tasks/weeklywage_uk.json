{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GB Real Weekly Wage",
    "anchor": "start",
    "subtitle": "Average weekly wage, constant prices,  £ | Source: ONS through ECO API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "height": 300,
  "width": 800,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/gbr/wage_r?vega",
    "format": {"type": "json"}
  },
  "mark": {"type": "line", "color": "#ff6b42", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "scale": { "domain": ["2000-01-01", "2024-12-31"] },
      "axis": { "title": "year", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": false }
},
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": { "domain": [350, 550] },
      "axis": { "title": "", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": true }
}

  },
  "config": {}
}