{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GCC GDP Growth by Country",
    "anchor": "start",
    "subtitle": "Select a country to view GDP growth (%) | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 700,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "params": [
    {
      "name": "countrySelect",
      "value": "Saudi Arabia",
      "bind": {
        "input": "select",
        "options": ["Saudi Arabia", "United Arab Emirates", "Qatar", "Kuwait", "Bahrain", "Oman"],
        "name": "Select Country: "
      }
    }
  ],
  "data": {
    "url": "cc9_gcc_all.json"
  },
  "transform": [
    {"filter": "datum.country == countrySelect"}
  ],
  "mark": {"type": "line", "color": "#ff6b42", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "Year", "grid": false, "labelAngle": -45}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"labelColor": "#ffffff", "titleColor": "#ffffff", "title": "GDP Growth (%)", "grid": true}
    },
    "tooltip": [
      {"field": "country", "title": "Country"},
      {"field": "date", "title": "Year"},
      {"field": "value", "type": "quantitative", "title": "GDP Growth (%)", "format": ".2f"}
    ]
  }
}