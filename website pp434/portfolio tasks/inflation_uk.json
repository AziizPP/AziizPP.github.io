{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GB Inflation",
    "anchor": "start",
    "subtitle": "All items, % | Source: ONS through ECO API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#efefef",
    "subtitleColor": "#f2f2f2"
  },
  "height": 300,
  "width": 800,
  "autosize": { "type": "fit", "contains": "padding", "resize": true },
  "background": "#2f393f",
  "view": { "fill": "#2f393f", "strokeOpacity": 0 },

  "data": {
    "url": "https://api.economicsobservatory.com/gbr/infl?vega",
    "format": { "type": "json" }
  },

  "transform": [
    {
      "filter": "toDate(datum.date) >= toDate('2000-01-01') && toDate(datum.date) <= toDate('2024-12-31')"
    }
  ],

  "mark": { "type": "line", "color": "#ff6b42", "strokeWidth": 2, "clip": true },

  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "scale": { "domain": ["2000-01-01", "2024-12-31"] },
      "axis": { "title": "year", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": false }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": { "title": "", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": true }
    }
  },
  "config": {}
}
