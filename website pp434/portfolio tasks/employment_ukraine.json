{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Employment Rate in Ukraine",
    "anchor": "start",
    "subtitle": "Rate, % | Source: WB through ECO API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#f2f2f2",
    "subtitleColor": "#f2f2f2"
  },
  "height": 300,
  "width": 400,
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/ukr/empl?vega",
    "format": {"type": "json"}
  },
  "mark": {"type": "line", "color": "#ff6b42", "strokeWidth": 2},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "year", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "", "labelColor": "#ffffff", "titleColor": "#ffffff", "grid": false}
    }
  },
  "config": {}
}