{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GCC FDI Comparison",
    "anchor": "start",
    "subtitle": "Select a country | Billion US$ | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 800,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "params": [
    {
      "name": "countrySelect",
      "value": "Saudi Arabia",
      "bind": {
        "input": "select",
        "options": ["Saudi Arabia", "United Arab Emirates", "Qatar", "Kuwait", "Bahrain", "Oman"],
        "name": "Country: "
      }
    }
  ],
  "data": {"url": "project_gcc_fdi_all.json"},
  "transform": [
    {"filter": "datum.country == countrySelect"},
    {"calculate": "datum.value / 1e9", "as": "fdi_billions"}
  ],
  "mark": {"type": "line", "color": "#ff6b42", "strokeWidth": 4},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"title": "", "labelAngle": -45, "grid": false, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "y": {
      "field": "fdi_billions",
      "type": "quantitative",
      "axis": {"title": "FDI (Billion US$)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "tooltip": [
      {"field": "country", "title": "Country"},
      {"field": "date", "title": "Year"},
      {"field": "fdi_billions", "title": "FDI (Billion US$)", "format": ".1f"}
    ]
  }
}