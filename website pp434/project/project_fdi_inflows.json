{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "FDI Net Inflows to Saudi Arabia (1990-2023)",
    "anchor": "start",
    "subtitle": "Billion US$ | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 800,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "project_fdi_inflows_data.json"},
  "transform": [
    {"calculate": "datum.value / 1e9", "as": "fdi_billions"}
  ],
  "mark": {"type": "area", "color": "#ff6b42", "opacity": 1},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"title": "", "labelAngle": -45, "grid": false, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "y": {
      "field": "fdi_billions",
      "type": "quantitative",
      "axis": {"title": "FDI (Billion US$)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "tooltip": [
      {"field": "date", "title": "Year"},
      {"field": "fdi_billions", "title": "FDI (Billion US$)", "format": ".1f"}
    ]
  }
}