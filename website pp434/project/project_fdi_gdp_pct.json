{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "FDI as Percentage of GDP",
    "anchor": "start",
    "subtitle": "Saudi Arabia | Source: World Bank",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#ececec",
    "subtitleColor": "#ececec"
  },
  "width": 800,
  "height": 350,
  "background": "#2f393f",
  "view": {"fill": "#2f393f", "strokeOpacity": 0},
  "data": {"url": "project_fdi_gdp_pct_data.json"},
  "mark": {"type": "bar", "color": "#ff6b42"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "axis": {"title": "", "labelAngle": -45, "grid": false, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "FDI (% of GDP)", "grid": true, "labelColor": "#ffffff", "titleColor": "#ffffff"}
    },
    "tooltip": [
      {"field": "date", "title": "Year"},
      {"field": "value", "title": "FDI (% of GDP)", "format": ".2f"}
    ]
  }
}